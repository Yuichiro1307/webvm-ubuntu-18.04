FROM --platform=linux/386 docker.io/i386/ubuntu:18.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    dbus-x11 \
    x11-xserver-utils \
    xauth \
    xorg \
    i3 \
    xterm \
    sudo \
    vim \
    curl \
    git \
    python3 \
    python3-pip \
    gcc \
    make \
    net-tools \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m user

WORKDIR /root

ENV HOME="/root" \
    TERM="xterm" \
    USER="root" \
    SHELL="/bin/bash" \
    DISPLAY=":0"

COPY dockerfiles/start-gui.sh /root/start-gui.sh

RUN chmod +x /root/start-gui.sh

CMD ["/root/start-gui.sh"]
